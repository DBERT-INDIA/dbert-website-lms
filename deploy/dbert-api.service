[Unit]
Description=DBERT REST API FastAPI Application
After=network.target postgresql.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/dbert-website-lms/dbert-api-package
EnvironmentFile=/var/www/dbert-website-lms/dbert-api-package/.env
Environment="PYTHONPATH=/var/www/dbert-website-lms/dbert-api-package"
ExecStart=/var/www/dbert-website-lms/dbert-api-package/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000 --workers 4

Restart=always
RestartSec=5
KillMode=mixed

[Install]
WantedBy=multi-user.target
