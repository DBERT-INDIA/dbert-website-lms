# DBERT Internship Portal - Staging Environment Configuration
# Target server path: /var/www/apps/staging-internship/.env
# Isolation Rule: Never share credentials, databases, or mail delivery with Production

FLASK_DEBUG=false
COOKIE_SECURE=1
PORT=5001
SITE_ORIGIN=https://staging-internship.dbert.online

# Cryptographic Keys (Distinct from Production)
FLASK_SECRET_KEY=staging_4ae9da5e77123955b65060c61dce5e13ac068f3cd56e511ac530006dedb77723
CRON_SECRET=staging_fc1866c731d35377a4819619d40661fc4ed7d469d868cd4ac172c61da4325964
FERNET_KEY=NEqaIL01dnM1Xu2vVJRNx1HdnOzUnJNxTbVqe2apcW4=

# Staging Administrator Credentials
ADMIN_USERNAME=dbert_staging_admin
ADMIN_PASSWORD=StagingAdmin@2026!SecureKey
ADMIN_KEY=staging_HdeGx_ym6RE6sMXYxHykZpc3Zw4w6iOS

# Database Configuration (Separate Isolated DB)
DB_FILE=internship_staging.db

# File Upload Storage (Separate Isolated Directory)
UPLOAD_FOLDER=uploads_staging

# Ambassador Program
AMBASSADOR_ENABLED=1

# Email Configuration: Test Mode (Prevent sending real user emails)
EMAILS_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=staging@dbert.online
SMTP_PASS=staging_test_only
FROM_EMAIL=staging@dbert.online
FROM_NAME=DBERT Staging Portal

# Anti-Bot (Disabled for staging automated E2E tests)
TURNSTILE_ENABLED=false
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# Payment Configuration (Test Mode)
UPI_ID=staging.test@upi
UPI_AMOUNT=1
