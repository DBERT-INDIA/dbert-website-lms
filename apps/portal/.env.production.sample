# ==============================================================================
# DBERT Portal — Production Environment Configuration (.env)
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to '.env' on your cPanel server (inside your app directory).
# ==============================================================================

FLASK_DEBUG=false
FLASK_SECRET_KEY=replace-with-a-random-secure-64-character-string

# Admin Portal Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-to-a-very-strong-password
ADMIN_KEY=change-to-a-secret-admin-key

# Site Canonical URL (no trailing slash)
SITE_ORIGIN=https://internship.dbert.online

# Database Configuration (leave as internship.db if in the same folder)
DB_FILE=internship.db

# File Uploads Directory
UPLOAD_FOLDER=uploads

# cPanel SMTP Email Configuration
EMAIL_PROVIDER=smtp
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=careers@yourdomain.com
SMTP_PASS=your-cpanel-email-password
FROM_EMAIL=careers@yourdomain.com
FROM_NAME=DBERT Support
