# ==============================================================================
# DBERT LMS — Production Environment Configuration for AWS EC2 (.env)
# Target: /var/www/dbert-website-lms/apps/portal/.env
# ==============================================================================

FLASK_DEBUG=false
FLASK_ENV=production
SECRET_KEY=change-to-a-very-strong-random-secret-key-at-least-64-chars
FLASK_SECRET_KEY=change-to-a-very-strong-random-secret-key-at-least-64-chars
CRON_SECRET=change-to-a-random-cron-secret-key

# Admin Portal Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-to-a-very-strong-admin-password
ADMIN_KEY=change-to-a-secret-admin-key

# Site Canonical URL
SITE_ORIGIN=https://lms.dbert.in
EMAIL_SITE=https://lms.dbert.in
SESSION_COOKIE_DOMAIN=.dbert.in

# Database Configuration (PostgreSQL 15 on EC2)
REQUIRE_POSTGRES=true
DATABASE_URL=postgresql://dbert_user:your_secure_postgres_password@localhost:5432/dbert_lms

# File Uploads Directory
UPLOAD_FOLDER=/var/www/dbert-website-lms/apps/portal/uploads

# Transactional Email Configuration (Google Workspace SMTP primary + cPanel Relay fallback)
EMAILS_ENABLED=true
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=abhinav.sharma@dbert.in
SMTP_PASS=rsupmvvvvwrsuxuh
FROM_EMAIL=abhinav.sharma@dbert.in
FROM_NAME="DBERT Support"
REPLY_TO_EMAIL=support@dbert.in
EMAIL_PACING_SECONDS=15
CPANEL_EMAIL_API_URL=https://mailer.aivaratech.online/send

# Razorpay Production Keys (Finding R2-05: Added RAZORPAY_WEBHOOK_SECRET)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Google Gemini AI Interviewer & Tutor (Optional / Rotated)
GEMINI_API_KEY=your_gemini_api_key
