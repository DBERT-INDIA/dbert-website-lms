# dbert-mailer — copy to .env on the cPanel app and fill in real values.
# Never commit the real .env.

# Shared secret the portal sends as the X-API-Key header. Generate with:
#   python -c "import secrets;print(secrets.token_hex(32))"
API_KEY=change-me-to-a-long-random-string

# cPanel mailbox, sent to over localhost SMTP (not blocked like EC2 egress).
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USER=careers@dbert.info
MAIL_PASS=your-mailbox-password

# Sender-lock (anti open-relay): only these domains may ever be used as the From
# address; anything else falls back to DEFAULT_FROM_EMAIL. Comma-separated.
ALLOWED_SENDER_DOMAINS=dbert.info,dbert.online
DEFAULT_FROM_EMAIL=careers@dbert.info
DEFAULT_FROM_NAME=DBERT Careers

# Simple in-proc rate limit (sends per rolling 60s window, per process).
RATE_LIMIT_PER_MIN=60
