# DEPRECATED: Retained for backward-compatibility.
# Use deploy/dbert-portal.service for EC2 unified deployments.
[Unit]
Description=DBERT LMS Platform Gunicorn Application (Legacy Service File)
After=network.target postgresql.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/dbert-website-lms/apps/portal
EnvironmentFile=/var/www/dbert-website-lms/apps/portal/.env

ExecStart=/var/www/dbert-website-lms/apps/portal/.venv/bin/gunicorn \
    --workers 4 \
    --bind 127.0.0.1:5001 \
    --timeout 90 \
    wsgi:app

Restart=always
RestartSec=5
KillMode=mixed

[Install]
WantedBy=multi-user.target
