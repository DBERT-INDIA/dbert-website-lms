# Environment variables for DBERT Website

# Prisma database connection
DATABASE_URL="postgres://user:password@localhost:5432/dbname"

# Razorpay server-side order creation
RAZORPAY_KEY_ID="rzp_test_placeholder"

# Razorpay server-side order creation + signature verification
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"

# Razorpay client-side checkout widget
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"

# Razorpay webhook signature verification
RAZORPAY_WEBHOOK_SECRET="webhook_secret_placeholder"

# Admin session auth
JWT_SECRET="jwt_secret_placeholder"

# One-time bootstrap of first AdminUser
ADMIN_SETUP_TOKEN="admin_setup_token_placeholder"

# Google Analytics 4 ID
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Metadata site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
